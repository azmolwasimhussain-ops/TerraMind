{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@4"
    }
  },
  "rewrites": [
    {
      "source": "/api/ollama/version",
      "destination": "/api/ollama/version"
    },
    {
      "source": "/api/ollama/tags",
      "destination": "/api/ollama/tags"
    },
    {
      "source": "/api/ollama/generate",
      "destination": "/api/ollama/generate"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
